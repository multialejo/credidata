
APP_NAME=CrediData
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# PRODUCTION: APP_ENV=production, APP_DEBUG=false, APP_URL=http://<YOUR_VPS_IP>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=credidata
DB_USERNAME=sail
DB_PASSWORD=

# Sanctum
# Comma-separated list of hosts that receive stateful SPA auth cookies.
# Add every hostname/IP users will use to reach the app (localhost for dev,
# LAN IPs for shared-network access, the public domain in production).
SANCTUM_STATEFUL_DOMAINS=localhost

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: SESSION_DRIVER=redis, SESSION_SECURE_COOKIE=false (no SSL yet)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

#Horizon
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
# PRODUCTION: QUEUE_CONNECTION=redis, CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# PRODUCTION: REDIS_HOST=127.0.0.1, REDIS_PASSWORD=<generated>

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# PRODUCTION: Use Mailgun, SendGrid, or similar SMTP service

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false

# Firebase
FIREBASE_CREDENTIALS=storage/app/firebase/credentials.json
FIREBASE_PROJECT_ID=credidata-dev
GOOGLE_APPLICATION_CREDENTIALS=storage/app/firebase/credentials.json
# PRODUCTION: Upload service account JSON to storage/app/firebase/ on VPS

# Dinardap
DINARDAP_MOCK=true
DINARDAP_API_URL=
DINARDAP_API_TOKEN=
DINARDAP_API_USER=
DINARDAP_API_IP=127.0.0.1
DINARDAP_DEFAULT_TIMEOUT=8

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MOCK=false
PAYPAL_TIMEOUT=10
# Leave EMPTY to auto-derive from the current request host (works for localhost,
# LAN IPs, and production domains without per-machine env edits).
# Set ONLY if you must pin a specific URL (e.g. public domain behind a proxy).
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# Payphone
PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_STORE_ID=
PAYPHONE_API_TOKEN=
PAYPHONE_MOCK=false
PAYPHONE_TIMEOUT=10
PAYPHONE_CURRENCY=USD
PAYPHONE_REFERENCE="CrediData recarga"
# Leave EMPTY to auto-derive from the current request host. The Payphone
# Dashboard allowed-domains list must be kept in sync with whatever host
# ends up in these URLs (out of project scope).
PAYPHONE_RESPONSE_URL=
PAYPHONE_CANCELLATION_URL=
